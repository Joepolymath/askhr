# ---- Database (used by docker-compose; DATABASE_URL is derived from these) ----
POSTGRES_USER=askhr
POSTGRES_PASSWORD=askhr
POSTGRES_DB=askhr
# Only needed when running the backend outside docker compose:
# DATABASE_URL=postgresql+asyncpg://askhr:askhr@localhost:5432/askhr

# ---- Admin auth ----
# Password HR uses to sign in to the admin dashboard.
ADMIN_PASSWORD=change-me
# Secret used to sign admin JWTs (HS256). Use a long random string: `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string
# Admin session length in hours.
JWT_EXPIRE_HOURS=8

# ---- LLM (chat) ----
# openai | anthropic | fake (fake = deterministic test double, no network)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini
# ---- Embeddings ----
# openai | fake
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# Must match the vector column size in the migration (1536 for text-embedding-3-small).
EMBEDDING_DIMENSIONS=1536

# ---- Provider API keys (never commit real values) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---- Retrieval ----
# Number of chunks retrieved per question.
TOP_K=6
# Minimum cosine similarity (0..1) for a chunk to count as relevant.
SIMILARITY_THRESHOLD=0.30

# ---- Web ----
# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
# Shown in the "I don't know" reply so employees know where to go.
HR_CONTACT=hr@northwindlabs.example
