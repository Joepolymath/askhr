# ---- Secrets: never commit real env files (the template is committed) ----
.env
.env.*
!.env.example

# ---- Python (backend) ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ---- Node (frontend) ----
node_modules/
dist/
*.tsbuildinfo
.vite/
npm-debug.log*

# ---- Logs ----
*.log

# ---- Editors / OS ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

